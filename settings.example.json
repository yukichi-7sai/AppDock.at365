{
  "schemaVersion": 1,
  "host": {
    "theme": "dark",
    "showHints": true,
    "closeToTray": true,
    "notifications": true,
    "startMinimized": false,
    "hardwareAcceleration": false,
    "trayClickCommand": "appdock.open",
    "trayDoubleClickCommand": null,
    "shellProviders": {}
  },
  "updates": {
    "hostSource": "github:yukichi-7sai/AppDock.at365",
    "checkHostOnStartup": false,
    "checkAppletsOnStartup": false,
    "startupDelaySeconds": 10,
    "notifyOnStartup": true,
    "allowSameVersion": false
  },
  "shortcuts": {
    "appdock.commands.search": ["Ctrl+P", "Ctrl+Shift+P"],
    "appdock.settings.open": ["Ctrl+,"]
  },
  "globalShortcutCommands": [],
  "trayCommands": [],
  "pinnedCommands": [],
  "profile": {
    "name": "User",
    "avatar": null
  },
  "extensions": {},
  "webApplets": {
    "items": [],
    "shortcutDefaults": [
      {
        "command": "reload",
        "key": "F5",
        "enabled": true,
        "when": {
          "scope": "owner",
          "appletIds": []
        }
      },
      {
        "command": "back",
        "key": "Alt+Left",
        "enabled": true,
        "when": {
          "scope": "owner",
          "appletIds": []
        }
      },
      {
        "command": "forward",
        "key": "Alt+Right",
        "enabled": true,
        "when": {
          "scope": "owner",
          "appletIds": []
        }
      }
    ]
  },
  "keybindings": [
    {
      "id": "default.0.0",
      "command": "appdock.commands.search",
      "key": "Ctrl+P",
      "enabled": true,
      "when": {
        "scope": "app",
        "appletIds": []
      }
    },
    {
      "id": "default.0.1",
      "command": "appdock.commands.search",
      "key": "Ctrl+Shift+P",
      "enabled": true,
      "when": {
        "scope": "app",
        "appletIds": []
      }
    },
    {
      "id": "default.1.0",
      "command": "appdock.settings.open",
      "key": "Ctrl+,",
      "enabled": true,
      "when": {
        "scope": "app",
        "appletIds": []
      }
    }
  ],
  "gestures": {
    "wheelDelayMs": 0,
    "browsers": ["chrome", "msedge", "firefox"],
    "bindings": [],
    "indicatorPosition": "gesture-start",
    "enabled": true,
    "distance": 50,
    "excludedProcesses": [],
    "indicatorOpacity": 0.45,
    "requireChromiumWindowClass": false
  },
  "gestureDefaultsInitialized": [],
  "tts": {
    "baseUrl": "",
    "model": "",
    "defaultVoice": "",
    "defaultSpeed": 1,
    "speedMode": "playback",
    "voicesSource": "endpoint",
    "voicesPath": "audio/voices",
    "manualVoices": []
  }
}

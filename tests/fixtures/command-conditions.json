{
  "conditions": [
    {
      "name": "binding process exclusion ignores case and exe suffix",
      "when": { "scope": "global", "excludedProcesses": ["NOTEpad.EXE"] },
      "context": { "host": {}, "target": { "window": "1", "processName": "notepad" } },
      "expected": false
    },
    {
      "name": "trigger exclusions remain active with binding exclusions",
      "when": { "scope": "global", "excludedProcesses": ["editor"] },
      "environment": { "excludedProcesses": ["notepad"] },
      "context": { "host": {}, "target": { "window": "1", "processName": "NOTEPAD.EXE" } },
      "expected": false
    },
    {
      "name": "binding exclusions add to trigger exclusions",
      "when": { "scope": "global", "excludedProcesses": ["editor"] },
      "environment": { "excludedProcesses": ["notepad"] },
      "context": { "host": {}, "target": { "window": "1", "processName": "editor.exe" } },
      "expected": false
    },
    {
      "name": "unlisted process allowed with both exclusions",
      "when": { "scope": "global", "excludedProcesses": ["editor"] },
      "environment": { "excludedProcesses": ["notepad"] },
      "context": { "host": {}, "target": { "window": "1", "processName": "browser" } },
      "expected": true
    },
    {
      "name": "exclusion requires known process",
      "when": { "scope": "global", "excludedProcesses": ["editor"] },
      "context": { "host": {}, "target": { "window": "1" } },
      "expected": false
    },
    {
      "name": "trigger exclusion applies to local bindings too",
      "when": { "scope": "app" },
      "environment": { "excludedProcesses": ["appdock.at365"] },
      "context": {
        "host": { "focused": true },
        "target": { "window": "1", "processName": "AppDock.at365.exe" }
      },
      "expected": false
    },
    {
      "name": "global without target",
      "when": { "scope": "global" },
      "context": { "host": {} },
      "expected": true
    },
    {
      "name": "unknown scope",
      "when": { "scope": "unknown" },
      "context": { "host": { "focused": true } },
      "expected": false
    },
    {
      "name": "app focused",
      "when": { "scope": "app" },
      "context": { "host": { "focused": true } },
      "expected": true
    },
    {
      "name": "app unknown",
      "when": { "scope": "app" },
      "context": { "host": {} },
      "expected": false
    },
    {
      "name": "pages needs a page",
      "when": { "scope": "pages" },
      "context": { "host": { "focused": true } },
      "expected": false
    },
    {
      "name": "host page",
      "when": { "scope": "pages" },
      "context": { "host": { "focused": true, "pageId": "host.settings" } },
      "expected": true
    },
    {
      "name": "legacy applet page",
      "when": { "scope": "pages" },
      "context": { "host": { "focused": true, "appletId": "test.owner" } },
      "expected": true
    },
    {
      "name": "stale page cannot match",
      "when": { "scope": "pages" },
      "context": { "host": { "focused": false, "pageId": "host.settings" } },
      "expected": false
    },
    {
      "name": "registered owner",
      "when": { "scope": "owner" },
      "ownerId": "test.owner",
      "context": { "host": { "focused": true, "appletId": "test.owner" } },
      "expected": true
    },
    {
      "name": "missing owner",
      "when": { "scope": "owner" },
      "context": { "host": { "focused": true, "appletId": "test.owner" } },
      "expected": false
    },
    {
      "name": "different owner",
      "when": { "scope": "owner" },
      "ownerId": "other",
      "context": { "host": { "focused": true, "appletId": "test.owner" } },
      "expected": false
    },
    {
      "name": "specific host page",
      "when": { "scope": "applets", "appletIds": ["host.settings"] },
      "context": { "host": { "focused": true, "pageId": "host.settings" } },
      "expected": true
    },
    {
      "name": "specific applet page",
      "when": { "scope": "applets", "appletIds": ["page:test.owner:history"] },
      "context": {
        "host": { "focused": true, "pageId": "page:test.owner:history", "appletId": "test.owner" }
      },
      "expected": true
    },
    {
      "name": "legacy whole applet",
      "when": { "scope": "applets", "appletIds": ["test.owner"] },
      "context": {
        "host": { "focused": true, "pageId": "page:test.owner:history", "appletId": "test.owner" }
      },
      "expected": true
    },
    {
      "name": "other page",
      "when": { "scope": "applets", "appletIds": ["host.logs"] },
      "context": { "host": { "focused": true, "pageId": "host.settings" } },
      "expected": false
    },
    {
      "name": "desktop confirmed",
      "when": { "scope": "desktop" },
      "context": { "host": {}, "target": { "window": "100", "desktop": true } },
      "expected": true
    },
    {
      "name": "desktop unknown",
      "when": { "scope": "desktop" },
      "context": { "host": {}, "target": { "window": "100" } },
      "expected": false
    },
    {
      "name": "folder not desktop",
      "when": { "scope": "desktop" },
      "context": {
        "host": {},
        "target": { "window": "100", "processName": "explorer", "desktop": false }
      },
      "expected": false
    },
    {
      "name": "browser case and suffix",
      "when": { "scope": "browser" },
      "environment": { "browsers": ["CHROME.EXE"] },
      "context": { "host": {}, "target": { "window": "100", "processName": "chrome" } },
      "expected": true
    },
    {
      "name": "browser needs environment",
      "when": { "scope": "browser" },
      "context": { "host": {}, "target": { "window": "100", "processName": "chrome" } },
      "expected": false
    },
    {
      "name": "browser requires real process",
      "when": { "scope": "browser" },
      "environment": { "browsers": ["chrome"] },
      "context": { "host": {} },
      "expected": false
    },
    {
      "name": "chromium class",
      "when": { "scope": "browser" },
      "environment": { "browsers": ["chrome"], "requireChromiumWindowClass": true },
      "context": {
        "host": {},
        "target": { "window": "100", "processName": "chrome", "windowClass": "Chrome_WidgetWin_1" }
      },
      "expected": true
    },
    {
      "name": "missing chromium class",
      "when": { "scope": "browser" },
      "environment": { "browsers": ["chrome"], "requireChromiumWindowClass": true },
      "context": { "host": {}, "target": { "window": "100", "processName": "chrome" } },
      "expected": false
    },
    {
      "name": "class is case sensitive",
      "when": { "scope": "browser" },
      "environment": { "browsers": ["chrome"], "requireChromiumWindowClass": true },
      "context": {
        "host": {},
        "target": { "window": "100", "processName": "chrome", "windowClass": "chrome_widgetwin_1" }
      },
      "expected": false
    },
    {
      "name": "exe",
      "when": { "scope": "exe", "processes": ["NOTEPAD.EXE"] },
      "context": { "host": {}, "target": { "window": "100", "processName": "notepad" } },
      "expected": true
    },
    {
      "name": "exe unknown",
      "when": { "scope": "exe", "processes": ["notepad"] },
      "context": { "host": {}, "target": { "window": "100" } },
      "expected": false
    },
    {
      "name": "exclude desktop",
      "when": { "scope": "global", "excludeDesktop": true },
      "context": { "host": {}, "target": { "window": "100", "desktop": true } },
      "expected": false
    },
    {
      "name": "exclude needs desktop fact",
      "when": { "scope": "global", "excludeDesktop": true },
      "context": { "host": {} },
      "expected": false
    },
    {
      "name": "exclude confirmed ordinary target",
      "when": { "scope": "global", "excludeDesktop": true },
      "context": { "host": {}, "target": { "window": "100", "desktop": false } },
      "expected": true
    },
    {
      "name": "exe excludes desktop",
      "when": { "scope": "exe", "processes": ["explorer"], "excludeDesktop": true },
      "context": {
        "host": {},
        "target": { "window": "100", "processName": "explorer", "desktop": true }
      },
      "expected": false
    }
  ],
  "selections": [
    {
      "name": "first skips process-excluded row without changing saved order",
      "context": { "host": {}, "target": { "window": "1", "processName": "row.exe" } },
      "environment": { "excludedProcesses": ["base"] },
      "mode": "first",
      "catalog": [{ "id": "a" }, { "id": "b" }],
      "rows": [
        { "id": "a", "command": "a", "when": { "scope": "global", "excludedProcesses": ["row"] } },
        { "id": "b", "command": "b", "when": { "scope": "global" } }
      ],
      "expectedRows": ["b"],
      "expectedCommands": ["b"]
    },
    {
      "name": "trigger exclusion prevents every selected command",
      "context": { "host": {}, "target": { "window": "1", "processName": "BASE.EXE" } },
      "environment": { "excludedProcesses": ["base"] },
      "mode": "all",
      "catalog": [{ "id": "a" }, { "id": "b" }],
      "rows": [
        { "id": "a", "command": "a", "when": { "scope": "global", "excludedProcesses": ["row"] } },
        { "id": "b", "command": "b", "when": { "scope": "global" } }
      ],
      "expectedRows": [],
      "expectedCommands": []
    },
    {
      "name": "filter then deduplicate in saved order",
      "context": { "host": { "focused": true } },
      "mode": "all",
      "catalog": [
        { "id": "a" },
        { "id": "b" },
        { "id": "c" },
        { "id": "disabled" },
        { "id": "unavailable", "available": false }
      ],
      "rows": [
        { "id": "not-owner", "command": "a", "when": { "scope": "owner" } },
        { "id": "missing", "command": "missing", "when": { "scope": "global" } },
        { "id": "off", "command": "disabled", "enabled": false, "when": { "scope": "global" } },
        { "id": "unavailable", "command": "unavailable", "when": { "scope": "global" } },
        { "id": "b-first", "command": "b", "when": { "scope": "app" } },
        { "id": "b-duplicate", "command": "b", "when": { "scope": "global" } },
        { "id": "c", "command": "c", "when": { "scope": "app" } }
      ],
      "expectedRows": ["b-first", "c"],
      "expectedCommands": ["b", "c"]
    },
    {
      "name": "first matching command after conditions",
      "context": { "host": { "focused": true, "appletId": "actual.owner" } },
      "mode": "first",
      "catalog": [
        { "id": "owner.prefix.command", "extensionId": "other" },
        { "id": "second", "extensionId": "actual.owner" },
        { "id": "third" }
      ],
      "rows": [
        { "id": "prefix", "command": "owner.prefix.command", "when": { "scope": "owner" } },
        { "id": "second", "command": "second", "when": { "scope": "owner" } },
        { "id": "third", "command": "third", "when": { "scope": "global" } }
      ],
      "expectedRows": ["second"],
      "expectedCommands": ["second"]
    },
    {
      "name": "unknown target never widens conditions",
      "context": { "host": {} },
      "mode": "all",
      "catalog": [{ "id": "a" }, { "id": "b" }],
      "rows": [
        { "id": "a", "command": "a", "when": { "scope": "desktop" } },
        { "id": "b", "command": "b", "when": { "scope": "global", "excludeDesktop": true } }
      ],
      "expectedRows": [],
      "expectedCommands": []
    }
  ],
  "inputExecutionModes": [
    {
      "name": "missing override inherits first",
      "fallback": "first",
      "overrides": {},
      "input": "move-up",
      "expected": "first"
    },
    {
      "name": "missing override inherits all",
      "fallback": "all",
      "overrides": {},
      "input": "move-up",
      "expected": "all"
    },
    {
      "name": "first overrides all",
      "fallback": "all",
      "overrides": { "move-up": "first" },
      "input": "move-up",
      "expected": "first"
    },
    {
      "name": "all overrides first",
      "fallback": "first",
      "overrides": { "move-up": "all" },
      "input": "move-up",
      "expected": "all"
    },
    {
      "name": "another input keeps fallback",
      "fallback": "first",
      "overrides": { "move-up": "all" },
      "input": "move-down",
      "expected": "first"
    }
  ],
  "stackConditions": [
  {
    "name": "empty stack is ineligible",
    "paths": [],
    "expected": false,
    "context": {
      "host": {
        "focused": false
      }
    }
  },
  {
    "name": "primitive has no additional conditions",
    "paths": null,
    "expected": true,
    "context": {
      "host": {}
    }
  },
  {
    "name": "nested owner requires both ancestor and registered child owner",
    "paths": [
      [
        {
          "when": {
            "scope": "app"
          }
        },
        {
          "when": {
            "scope": "owner"
          },
          "ownerId": "demo"
        }
      ]
    ],
    "expected": true,
    "context": {
      "host": {
        "appletId": "demo",
        "focused": true
      }
    }
  },
  {
    "name": "nested owner mismatch does not consume input",
    "paths": [
      [
        {
          "when": {
            "scope": "global"
          }
        },
        {
          "when": {
            "scope": "owner"
          },
          "ownerId": "other"
        }
      ]
    ],
    "expected": false,
    "context": {
      "host": {
        "appletId": "demo",
        "focused": true
      }
    }
  },
  {
    "name": "any complete path permits a stack",
    "paths": [
      [
        {
          "when": {
            "scope": "app"
          }
        }
      ],
      [
        {
          "when": {
            "scope": "global"
          }
        },
        {
          "when": {
            "processes": [
              "notepad"
            ],
            "scope": "exe"
          }
        }
      ]
    ],
    "expected": true,
    "context": {
      "host": {
        "focused": false
      },
      "target": {
        "window": "1",
        "processName": "notepad"
      }
    }
  },
  {
    "name": "unknown host state fails closed",
    "paths": [
      [
        {
          "when": {
            "scope": "app"
          }
        }
      ]
    ],
    "expected": false,
    "context": {
      "host": {}
    }
  }
]
}

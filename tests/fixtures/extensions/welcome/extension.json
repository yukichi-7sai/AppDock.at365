{
  "apiVersion": 1,
  "id": "appdock.welcome",
  "name": "Welcome to your Dock",
  "version": "0.1.0",
  "runtime": "node",
  "entry": "index.js",
  "description": "ホストAPIの動作を確認できる、TypeScript製の小さな拡張です。",
  "capabilities": ["notifications", "settings", "storage", "secrets"],
  "settings": [
    {
      "key": "greeting",
      "title": "ウェルカムメッセージ",
      "type": "string",
      "default": "自分の道具を、ひとつの場所に。"
    }
  ],
  "notificationTypes": [
    {
      "typeId": "fixture",
      "title": "Fixture notification",
      "levels": ["info"],
      "defaultLevel": "info",
      "allowedTargets": ["windows"],
      "defaultTargets": ["windows"],
      "lifetimePolicy": "userDuration",
      "defaultDurationSeconds": 10,
      "history": "none",
      "requiredTargets": [],
      "description": "Fixture notification delivery"
    }
  ],
  "minimumHostVersion": "0.180.0"
}

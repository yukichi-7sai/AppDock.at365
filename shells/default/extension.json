{
  "apiVersion": 1,
  "id": "appdock.default-shell",
  "name": "Default Shell",
  "version": "0.0.0",
  "runtime": "node",
  "entry": "worker.cjs",
  "capabilities": ["shell"],
  "shell": {
    "apiVersion": 1,
    "ribbonSchemaVersion": 3,
    "ui": "index.html",
    "views": {
      "titlebar": "bars.html",
      "statusbar": "bars.html",
      "notification.banner": "notifications.html",
      "notification.desktop": "notifications.html"
    }
  }
}

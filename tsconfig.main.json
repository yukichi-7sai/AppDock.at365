{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "#accent-colors": ["./src/main/core/accent-color-source.ts"],
      "#accent-color-defaults": ["./src/main/core/accent-color-defaults.ts"],
      "#host-translations": ["./src/main/core/host-translation-source.ts"],
      "#theme-defaults": ["./src/main/core/theme-defaults.ts"]
    },
    "rootDir": "src",
    "outDir": "out/main",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/renderer"]
}

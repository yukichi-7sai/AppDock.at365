{
  "name": "appdock-at365",
  "version": "0.109.2",
  "private": true,
  "description": "AppDock.at365",
  "author": "at365",
  "license": "MIT",
  "main": "out/main/main/bootstrap.js",
  "scripts": {
    "postinstall": "install-electron",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json",
    "build": "node scripts/build-main.cjs && node scripts/build-image-gallery.cjs && vite build && vite build --config vite.shell.config.mts && node scripts/build-shell.cjs",
    "build:image-gallery": "node scripts/build-image-gallery.cjs",
    "start": "pnpm run build && electron .",
    "test": "pnpm run build:updater && pnpm run build:process-host && pnpm run build && pnpm run build:test-extensions && node --test tests/*.test.cjs",
    "build:process-host": "dotnet publish dotnet/AppDock.ProcessHost/AppDock.ProcessHost.csproj -c Release -r win-x64 --self-contained true -o .artifacts/dotnet-host/process",
    "build:test-extensions": "node scripts/build-test-extensions.cjs",
    "build:dotnet": "node scripts/build-dotnet.cjs",
    "build:updater": "node scripts/build-updater.cjs",
    "pack:update": "node scripts/pack-update.cjs",
    "dist": "pnpm run dist:host",
    "dist:host": "pnpm run build:dotnet && pnpm run build:updater && pnpm run build && node scripts/build-portable.cjs && node scripts/publish-host.cjs",
    "pack:starter": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-starter.ps1",
    "smoke": "node scripts/smoke.cjs",
    "test:ui": "pnpm run build:test-extensions && node scripts/ui-test.cjs",
    "test:navigation": "pnpm run build:test-extensions && node scripts/navigation-ui-test.cjs",
    "test:preferences": "pnpm run build:test-extensions && node scripts/preferences-ui-test.cjs",
    "test:hotkeys": "pnpm run build:test-extensions && node scripts/hotkeys-ui-test.cjs",
    "test:window-state": "node scripts/window-state-ui-test.cjs",
    "test:host-commands": "node scripts/host-commands-ui-test.cjs",
    "test:tray": "node scripts/tray-commands-ui-test.cjs",
    "test:hardware-acceleration": "node scripts/hardware-acceleration-ui-test.cjs",
    "test:applet-sidebar": "node scripts/applet-sidebar-ui-test.cjs",
    "format": "prettier --write --ignore-path .gitignore src scripts tests"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "at365.appdock",
    "productName": "AppDock.at365",
    "executableName": "AppDock.at365",
    "directories": {
      "output": ".artifacts/host-build",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/icon.png",
      "assets/material-design-icons-LICENSE.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".artifacts/updater/AppDock.Updater.exe",
        "to": "updater/AppDock.Updater.exe"
      },
      {
        "from": ".artifacts/dotnet-host",
        "to": "dotnet-host"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "out/shells",
        "to": "shells"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "i18next": "26.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.0",
    "smol-toml": "1.9.1"
  }
}
